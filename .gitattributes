# Normalize line endings
* text=auto

# Force LF for source files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Binary files — no line ending conversion
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf
